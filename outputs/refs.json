      "decision",
      "adr"
    ],
    "content_type": "decision",
    "component": "adaptor",
    "status": "",
    "has_table": false,
    "has_image": false,
    "body_md": "The adaptor becomes a critical path component and must be highly available. Its payload\nmapping (see the Adaptor page) is the single source of truth for field translation.",
    "confluence_version": 2,
    "update_at": "2026-05-12T10:00:00Z",
    "captured_at": "2026-06-04T00:00:00Z"
  },
