    "source_url": "https://confluence.local/x/ADR-Single-Adaptor",
    "title": "Design Decision: Single Adaptor Layer",
    "heading_path": [
      "Design Decision: Single Adaptor Layer",
      "Rationale"
    ],
    "tree_path": [
      "06-Delivery",
      "10. Planned Project",
      "2026 Planned Project",
      "Design"
    ],
    "owner": "carol",
    "labels": [
      "design",
      "decision",
      "adr"
    ],
    "content_type": "decision",
    "component": "journey",
    "status": "",
    "has_table": false,
    "has_image": false,
    "body_md": "A single adaptor means format changes are handled in one place. Point-to-point would\nrequire N×M mappings and make migrations (e.g., SFMC) far riskier. The adaptor also lets\nDM and Journey deploy independently.",
    "confluence_version": 2,
    "update_at": "2026-05-12T10:00:00Z",
    "captured_at": "2026-06-04T00:00:00Z"
  },
  {
    "ref_id": 0,
    "section_id": "230088#Consequences",
    "page_id": "230088",
    "space": "DEPT",
    "source_url": "https://confluence.local/x/ADR-Single-Adaptor",
    "title": "Design Decision: Single Adaptor Layer",
    "heading_path": [
