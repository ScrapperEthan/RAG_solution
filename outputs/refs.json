    "has_table": false,
    "has_image": false,
    "body_md": "The Data Management plugin (**DM plugin**, sometimes abbreviated **DMP**) delivers\nmessages to downstream channels. It is the core component of the delivery pipeline and\nis responsible for batching, retrying, and handing messages off to the Journey plugin.",
    "confluence_version": 7,
    "update_at": "2026-05-20T10:00:00Z",
    "captured_at": "2026-06-04T00:00:00Z"
  },
  {
    "ref_id": 0,
    "section_id": "123456#Configuration",
    "page_id": "123456",
    "space": "DEPT",
    "source_url": "https://confluence.local/x/DM-Plugin-Overview",
    "title": "DM Plugin Overview",
    "heading_path": [
      "DM Plugin Overview",
      "Configuration"
    ],
    "tree_path": [
      "06-Delivery",
      "10. Planned Project",
      "2026 Planned Project",
      "Plugins"
    ],
    "owner": "alice",
    "labels": [
      "plugin",
      "delivery"
    ],
    "content_type": "config",
    "component": "DM",
    "status": "",
    "has_table": true,
    "has_image": false,
    "body_md": "| Param        | Default | Notes                         |\n|--------------|---------|-------------------------------|\n| `batch_size` | 500     | maximum allowed value is 1000 |\n| `max_retry`  | 3       | per-message retry attempts    |",
    "confluence_version": 7,
    "update_at": "2026-05-20T10:00:00Z",
    "captured_at": "2026-06-04T00:00:00Z"
  },
  {
