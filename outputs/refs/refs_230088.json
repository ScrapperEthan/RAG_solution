    "has_table": false,
    "has_image": false,
    "body_md": "A single adaptor means format changes are handled in one place. Point-to-point would\nrequire N×M mappings and make migrations (e.g., SFMC) far riskier. The adaptor also lets\nDM and Journey deploy independently.",
    "confluence_version": 2,
    "update_at": "2026-05-12T10:00:00Z",
    "captured_at": "2026-06-04T00:00:00Z"
  },
